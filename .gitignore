# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
.venv-*/
venv/
venv-*/
env/
ENV/
env.bak/
venv.bak/

# Local secrets and environment configuration
.env
.env.*
!.env.example
/.secrets/
/secrets/
/cookies.txt
/cookies.sqlite
/cookies.sqlite-*

# Local editor state
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~

# Test, coverage, lint and type-check output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
/coverage.xml
/junit.xml

# Packaging/build artifacts; dependency manifests and lockfiles stay trackable
/build/
/dist/
*.egg-info/
.eggs/
*.egg

# Logs and crash dumps
*.log
*.log.*
/logs/
/crash-dumps/
/*.dmp
/core
/core.[0-9]*
/hs_err_pid*.log

# SQLite state at repository root, including journal/WAL/SHM sidecars.
# Nested runtime databases belong under runtime/; fixtures remain trackable.
/*.db
/*.db-journal
/*.db-wal
/*.db-shm
/*.sqlite
/*.sqlite-journal
/*.sqlite-wal
/*.sqlite-shm
/*.sqlite3
/*.sqlite3-journal
/*.sqlite3-wal
/*.sqlite3-shm

# Disposable application data, extraction caches and downloaded media.
# Avoid global audio/video patterns: assets/ and tests/fixtures/ are legitimate.
/runtime/
/downloads/
/tmp/
/.cache/
/.yt-dlp/
/*.part
/*.part-Frag*
/*.ytdl

# OS-generated files
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
