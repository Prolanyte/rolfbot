# Process environment only; Rolfbot does not automatically load this file.
# Keep real secrets and guild/channel IDs in a private file OUTSIDE the checkout.
# See docs/LOCAL_TEST.md for the explicit owner-controlled local test workflow.
ROLFBOT_LOG_LEVEL=INFO
ROLFBOT_TIMEZONE=Europe/Oslo
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none

# Required for init-db, smoke-test and run. Existing parent directory required.
# Must be outside checkout/release/venv directories; no automatic missing-DB recovery.
# Local example: /absolute/path/to/your/home/.local/state/rolfbot/usage.sqlite3
# ROLFBOT_DATABASE_PATH=/var/lib/rolfbot/usage.sqlite3

# Optional for offline check-config/init-db. Placeholders are rejected live.
# Required for smoke-test --confirm-billable and run:
OPENAI_API_KEY=replace_with_your_openai_api_key
# Required only for run (use the existing bot account):
DISCORD_BOT_TOKEN=replace_with_your_discord_bot_token

# Required only for run: JSON guild ID -> list of ordinary text-channel IDs.
# SYNTHETIC identifiers only. Replace these in your PRIVATE configuration.
# Start with one test guild:
# ROLFBOT_GUILD_CHANNELS='{"111111111111111111":["222222222222222222"]}'
# Enable both after successful validation, without editing Python:
# ROLFBOT_GUILD_CHANNELS='{"111111111111111111":["222222222222222222"],"333333333333333333":["444444444444444444"]}'

# No settings override the 512-token ceiling, quotas or disabled OpenAI retries.
# OPENAI_CUSTOM_HEADERS and OPENAI_LOG are rejected at client initialization.
# SDK endpoint/project/admin-key overrides and proxy environment are not used.

# No scheduling, music, message history or automatic channel responses are active.
