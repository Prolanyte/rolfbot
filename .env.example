# Milestone 3: process environment only; no automatic .env loading.
# Implemented optional settings with safe defaults:
ROLFBOT_LOG_LEVEL=INFO
ROLFBOT_TIMEZONE=Europe/Oslo
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none

# Optional for offline check-config; REQUIRED when explicitly using usage storage.
# Absolute file path, outside production application release/venv directories.
# No command creates this database automatically. See README for provisioning.
# ROLFBOT_DATABASE_PATH=/var/lib/rolfbot/usage.sqlite3

# Credentials are optional for check-config. OPENAI_API_KEY is required only
# when explicitly constructing AIService; no CLI command initializes it yet.
# Placeholders only. Never put real credentials in this tracked example.
OPENAI_API_KEY=replace_with_your_openai_api_key
DISCORD_BOT_TOKEN=replace_with_your_discord_bot_token

# No settings can override the 512-token ceiling, quotas or disabled retries.
# OPENAI_CUSTOM_HEADERS and OPENAI_LOG are rejected at client initialization.
# SDK endpoint/project/admin-key overrides and proxy environment are not used.

# Future setting: documented only, NOT read or validated yet.
# ROLFBOT_GUILD_CHANNELS=replace_with_private_guild_to_channel_mapping
# Future behavior and usage limits are documented in docs/ROADMAP.md.
